:3 programa completo: exercita todos os itens exigidos no enunciado
program boletim.

/* declaracao de variaveis e vetores com multiplos ids */
int:) i, n, maior, aprovados.
float:) notas[50], soma, media.
string:) nome.
boolean:) passou.

/* funcao com parametro vetorial e escalar */
function float:) somatorio(float:) vet[], int:) tam)
{
  int:) k.
  float:) acc.
  acc = 0.0.
  for (k = 0, k < tam, k = k + 1) do
  {
    acc = acc + vet[k].
  }
  return acc
}

/* funcao chamando outra funcao */
function float:) calcula_media(float:) vet[], int:) tam)
{
  return somatorio(vet, tam) / tam.
}

/* procedimento com parametros literais e variaveis */
function imprime(string:) rotulo, float:) valor)
{
  write(rotulo, valor).
  return.
}

begin
  :3 entrada de dados com variaveis
  read(nome, n).

  :3 laco pre-testado com variavel de controle: leitura em vetor
  for (i = 0, i < n, i = i + 1) do
  {
    read(notas[i]).
  }

  :3 atribuicao recebendo chamadas de sub-rotina e expressao aritmetica
  soma = somatorio(notas, n).
  media = calcula_media(notas, n) * 1.0 + 0.0.

  :3 desvio condicional composto com expressao logica e relacional
  if (media >= 6.0 AND NOT (n == 0)) then
  {
    passou = true.
    imprime("aprovado com media ", media).
  }
  else
  {
    passou = false.
    imprime("reprovado com media ", media).
  }

  :3 laco pre-testado: conta aprovados
  aprovados = 0.
  i = 0.
  while (i < n) do
  {
    :3 desvio condicional simples, sem else
    if (notas[i] >= 6.0) then
    {
      aprovados = aprovados + 1.
    }
    i = i + 1.
  }

  :3 laco pos-testado: busca a maior nota
  maior = 0.
  i = n.
  do
  {
    i = i - 1.
    if (notas[i] > notas[maior]) then
    {
      maior = i.
    }
  }
  while (i > 0).

  :3 saida de dados com literais, variaveis e vetores
  write("aluno: ", nome).
  write("soma: ", soma, " media: ", media).
  write("aprovados: ", aprovados, " de ", n).
  write("maior nota: ", notas[maior], " indice ", maior).
  imprime("fim ", 0.0).
end.